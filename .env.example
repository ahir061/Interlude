# Copy to .env. Never commit real values.
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=your-hosted-qwen-model
LLM_API_KEY=replace-me
DB_HOST=localhost
DB_PORT=3306
DB_USER=interlude
DB_PASSWORD=replace-me
DB_NAME=interlude
GROQ_API_KEY=replace-me
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=bn
ASR_RESPONSE_FORMAT=verbose_json
ASR_TEMPERATURE=0
ASR_WORD_TIMESTAMPS=true
ASR_SEGMENT_TIMESTAMPS=true
ASR_REQUEST_TIMEOUT_SEC=180
ASR_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=1200
LLM_JSON_MODE=true
BRANDS_PATH=content-sample-assets-folder/brands.json
DATA_DIR=data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_BREAKS_PER_HOUR=12
MIN_BREAK_GAP_SEC=30
MAX_AD_LOAD_PERCENT=10
MIN_WHERE_SCORE=0.55
MIN_SEMANTIC_CONFIDENCE=0.7
WHERE_BOUNDARY_WEIGHT=0.25
WHERE_DIALOGUE_WEIGHT=0.2
WHERE_SEMANTIC_WEIGHT=0.2
WHERE_CLOSURE_WEIGHT=0.2
WHERE_STABILITY_WEIGHT=0.1
WHERE_CONFIDENCE_WEIGHT=0.05
SCENE_THRESHOLD=27
MAX_UPLOAD_MB=4096
MAX_VIDEO_DURATION_SEC=7200
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Phase 2 safety, context, optimizer and lifecycle controls
# Scene-grouping thresholds only; these do not veto ad opportunities.
MIN_TRANSITION_CONFIDENCE=0.8
MIN_TRANSITION_SCORE=0.65
SENSITIVE_CONTEXT_WINDOW_SEC=90
CONTEXT_SAMPLE_INTERVAL_SEC=20
CONTEXT_FRESHNESS_SEC=30
BRAND_ACTIVITY_WEIGHT=0.6
BRAND_TARGET_WEIGHT=0.25
BRAND_CATEGORY_WEIGHT=0.1
BRAND_SECONDARY_WEIGHT=0.05
SAFETY_MIN_CONFIDENCE=0.9
OPTIMIZER_BEAM_WIDTH=2048
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CONCURRENCY=3
WORKER_LEASE_SEC=900
WORKER_HEARTBEAT_SEC=15
UPLOAD_RETENTION_HOURS=72
WORK_RETENTION_HOURS=24
REPORTS_DIR=reports
MEDIA_BASE_URL=http://localhost:8000

# Episode processing and protected team workspace
AUDIO_CHUNK_SEC=300
AUDIO_CHUNK_OVERLAP_SEC=2
MEDIA_COMMAND_TIMEOUT_SEC=900
ENVIRONMENT=development
WORKSPACE_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SEC=43200
