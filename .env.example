# Copy to .env. Never commit real values.
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=your-hosted-qwen-model
LLM_API_KEY=replace-me
DB_HOST=localhost
DB_PORT=3306
DB_USER=interlude
DB_PASSWORD=replace-me
DB_NAME=interlude
GROQ_API_KEY=replace-me
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=bn
ASR_RESPONSE_FORMAT=verbose_json
ASR_TEMPERATURE=0
ASR_WORD_TIMESTAMPS=true
ASR_SEGMENT_TIMESTAMPS=true
ASR_REQUEST_TIMEOUT_SEC=180
ASR_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3
BRANDS_PATH=content-sample-assets-folder/brands.json
DATA_DIR=data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_BREAKS_PER_HOUR=12
MIN_BREAK_GAP_SEC=30
MAX_AD_LOAD_PERCENT=10
MIN_DIALOGUE_GAP_SEC=0.5
MIN_SCENE_SEC=2
MIN_EDGE_GAP_SEC=10
MIN_WHERE_SCORE=0.65
MIN_SEMANTIC_CONFIDENCE=0.7
MIN_BRAND_SCORE=0.15
WHERE_BOUNDARY_WEIGHT=0.2
WHERE_DIALOGUE_WEIGHT=0.25
WHERE_SILENCE_WEIGHT=0.2
WHERE_SEMANTIC_WEIGHT=0.35
SCENE_THRESHOLD=27
MAX_UPLOAD_MB=250
MAX_VIDEO_DURATION_SEC=300
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE=http://localhost:8000
